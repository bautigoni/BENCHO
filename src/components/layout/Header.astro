---
import Logo from '../Logo.astro';
import { NAV_LINKS } from '../../consts';
import { DEFAULT_WHATSAPP_HREF } from '../../lib/whatsapp';

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header
  data-header
  data-elevated="false"
  class="group bg-ink-950 sticky top-0 z-50 transition-shadow duration-300 data-[elevated=true]:shadow-xl data-[elevated=true]:shadow-black/50"
>
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-px overflow-hidden bg-white/10"
    aria-hidden="true"
  >
    <div
      class="via-brand-500 animate-scan-glow h-full w-1/4 bg-gradient-to-r from-transparent to-transparent"
    >
    </div>
  </div>
  <div
    class="container-page flex items-center justify-between py-3.5 transition-[padding] duration-300 group-data-[elevated=true]:py-2.5"
  >
    <div class="animate-fade-in">
      <Logo theme="light" />
    </div>

    <nav aria-label="Navegación principal" class="hidden items-center gap-1 md:flex">
      {
        NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'group/link relative rounded-full px-4 py-2 text-sm font-medium transition-colors',
              isActive(link.href) ? 'text-white' : 'text-white/60 hover:text-white'
            ]}
          >
            {link.label}
            <span
              class:list={[
                'bg-brand-400 absolute inset-x-4 -bottom-0.5 h-0.5 origin-left scale-x-0 rounded-full transition-transform duration-300 ease-out group-hover/link:scale-x-100',
                isActive(link.href) && 'scale-x-100'
              ]}
              aria-hidden="true"
            />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={DEFAULT_WHATSAPP_HREF}
        data-whatsapp-cta
        data-cta-location="header"
        data-track="cta_click"
        class="bg-brand-500 text-ink-950 hover:bg-brand-400 hidden items-center rounded-full px-5 py-2.5 text-sm font-semibold shadow-md shadow-black/20 transition-all hover:-translate-y-0.5 hover:shadow-lg sm:inline-flex"
      >
        Solicitar Presupuesto
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de navegación"
        class="group/burger relative inline-flex size-11 shrink-0 items-center justify-center rounded-full text-white transition-all hover:bg-white/10 active:scale-90 md:hidden"
      >
        <span class="relative flex h-3.5 w-5 flex-col justify-between">
          <span
            class="h-0.5 w-full origin-center rounded-full bg-current transition-transform duration-300 group-aria-expanded/burger:translate-y-[6px] group-aria-expanded/burger:rotate-45"
          ></span>
          <span
            class="h-0.5 w-full rounded-full bg-current transition-opacity duration-200 group-aria-expanded/burger:opacity-0"
          ></span>
          <span
            class="h-0.5 w-full origin-center rounded-full bg-current transition-transform duration-300 group-aria-expanded/burger:-translate-y-[6px] group-aria-expanded/burger:-rotate-45"
          ></span>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    data-menu-panel
    data-state="closed"
    style="top: var(--header-h, 4rem)"
    class="group/menu bg-ink-950 fixed inset-x-0 bottom-0 z-40 flex flex-col gap-1 overflow-y-auto p-6 transition-[opacity,visibility] duration-300 ease-out data-[state=closed]:pointer-events-none data-[state=closed]:invisible data-[state=closed]:opacity-0 data-[state=open]:opacity-100 md:hidden"
  >
    {
      NAV_LINKS.map((link, index) => (
        <a
          href={link.href}
          style={`transition-delay:${index * 60}ms`}
          class:list={[
            'translate-y-2 rounded-2xl px-4 py-3.5 text-lg font-medium opacity-0 transition-[opacity,transform,background-color] duration-300 ease-out group-data-[state=open]/menu:translate-y-0 group-data-[state=open]/menu:opacity-100 active:scale-95',
            isActive(link.href) ? 'bg-white/10 text-white' : 'text-white/70'
          ]}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={DEFAULT_WHATSAPP_HREF}
      data-whatsapp-cta
      data-cta-location="mobile_menu"
      data-track="cta_click"
      style={`transition-delay:${NAV_LINKS.length * 60}ms`}
      class="bg-brand-500 text-ink-950 mt-4 inline-flex translate-y-2 items-center justify-center rounded-full px-5 py-4 text-lg font-semibold opacity-0 transition-[opacity,transform] duration-300 ease-out group-data-[state=open]/menu:translate-y-0 group-data-[state=open]/menu:opacity-100 active:scale-95"
    >
      Solicitar Presupuesto
    </a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (toggle && panel) {
    const close = () => {
      toggle.setAttribute('aria-expanded', 'false');
      panel.dataset.state = 'closed';
      document.body.style.removeProperty('overflow');
    };

    const open = () => {
      toggle.setAttribute('aria-expanded', 'true');
      panel.dataset.state = 'open';
      document.body.style.overflow = 'hidden';
    };

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      if (isOpen) {
        close();
      } else {
        open();
      }
    });

    panel.querySelectorAll('a').forEach((link) => link.addEventListener('click', close));
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') close();
    });
  }

  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const updateElevation = () => {
      header.dataset.elevated = window.scrollY > 8 ? 'true' : 'false';
    };
    updateElevation();
    window.addEventListener('scroll', updateElevation, { passive: true });

    const syncHeaderHeight = () => {
      document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
    };
    syncHeaderHeight();
    window.addEventListener('resize', syncHeaderHeight);
    new ResizeObserver(syncHeaderHeight).observe(header);
  }
</script>
