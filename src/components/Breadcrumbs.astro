---
import { ChevronRight } from '@lucide/astro';
import { buildBreadcrumbSchema, type BreadcrumbItem } from '../lib/schema';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
const fullItems: BreadcrumbItem[] = [{ name: 'Inicio', url: '/' }, ...items];
const schema = buildBreadcrumbSchema(fullItems);
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
<nav aria-label="Breadcrumb" class="container-page py-5">
  <ol class="text-ink-500 flex flex-wrap items-center gap-1.5 text-sm">
    {
      fullItems.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {index > 0 && <ChevronRight class="text-ink-300 size-3.5" aria-hidden="true" />}
          {index === fullItems.length - 1 ? (
            <span class="text-ink-800 font-medium" aria-current="page">
              {item.name}
            </span>
          ) : (
            <a href={item.url} class="hover:text-brand-700 transition-colors">
              {item.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
