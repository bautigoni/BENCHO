---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'center', class: className = '' } = Astro.props;
---

<div class:list={['reveal max-w-2xl', align === 'center' ? 'mx-auto text-center' : 'text-left', className]}>
  {eyebrow && <p class="text-brand-700 text-sm font-semibold tracking-wide uppercase">{eyebrow}</p>}
  <h2 class="mt-3 text-3xl font-bold text-balance sm:text-4xl lg:text-5xl">{title}</h2>
  {description && <p class="text-ink-500 mt-5 text-lg text-pretty">{description}</p>}
</div>
