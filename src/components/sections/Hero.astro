---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import heroImage from '../../assets/images/proyectos/hero-casa-pileta.png';
import Logo from '../Logo.astro';
import { DEFAULT_WHATSAPP_HREF } from '../../lib/whatsapp';
---

<section data-top-brand class="bg-surface-dark relative isolate min-h-[100dvh] overflow-hidden">
  <Image
    src={heroImage}
    alt="Casa de fachada blanca junto a una pileta, intervenida por Grupo CGR"
    class="absolute inset-0 size-full object-cover object-[58%_center] sm:object-[55%_center]"
    widths={[640, 828, 1200, 1600]}
    sizes="100vw"
    quality={100}
    loading="eager"
    fetchpriority="high"
  />

  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_12%_76%,rgba(31,31,33,0.62)_0%,rgba(31,31,33,0.28)_34%,transparent_62%),linear-gradient(180deg,rgba(31,31,33,0.16)_0%,transparent_30%)]"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative z-10 flex min-h-[100dvh] flex-col pt-6 pb-10 sm:pt-8 sm:pb-12">
    <Logo theme="light" />

    <div class="mt-auto max-w-lg">
      <h1
        class="max-w-[8ch] text-[clamp(2.8rem,7.8vw,5.7rem)] leading-[0.9] font-semibold tracking-[-0.065em] text-balance text-white"
      >
        Construimos <span class="text-brand-500">confianza.</span>
      </h1>

      <p class="mt-5 max-w-sm text-base leading-relaxed text-pretty text-white/86 sm:text-lg">
        Obras prolijas, plazos claros y atención directa.
      </p>

      <a
        href={DEFAULT_WHATSAPP_HREF}
        data-whatsapp-cta
        data-cta-location="hero"
        data-track="cta_click"
        class="group bg-brand-500 hover:bg-brand-600 text-ink-950 mt-7 inline-flex w-fit items-center justify-center gap-2 rounded-full px-7 py-4 text-base font-semibold transition-all hover:-translate-y-0.5 active:translate-y-px"
      >
        Solicitar Presupuesto
        <ArrowRight class="size-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
