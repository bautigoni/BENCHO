---
import { ArrowRight } from '@lucide/astro';
import { SITE } from '../../consts';
import { DEFAULT_WHATSAPP_HREF } from '../../lib/whatsapp';
---

<section class="relative overflow-hidden border-y border-[#ded8cf] bg-[#efe9e1] py-24 sm:py-32">
  <div
    class="bg-brand-500/30 pointer-events-none absolute -top-2/3 left-1/2 aspect-square w-[55rem] -translate-x-1/2 rounded-full blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative text-center">
    <p class="reveal text-brand-800 text-xs font-semibold tracking-[0.18em] uppercase">
      Hablemos de tu proyecto
    </p>
    <h2 class="reveal text-ink-950 mx-auto mt-5 max-w-3xl text-3xl font-semibold text-balance sm:text-5xl">
      Tu proyecto merece un equipo en el que puedas confiar.
    </h2>
    <p class="reveal text-ink-600 mx-auto mt-5 max-w-xl text-lg leading-relaxed text-pretty">
      Contanos qué necesitás y te respondemos por WhatsApp con la misma transparencia que nos define desde {
        SITE.foundingYear
      }.
    </p>
    <div class="reveal mt-10">
      <a
        href={DEFAULT_WHATSAPP_HREF}
        data-whatsapp-cta
        data-cta-location="final_cta"
        data-track="cta_click"
        class="group bg-brand-500 hover:bg-brand-600 text-ink-950 inline-flex items-center justify-center gap-2 rounded-full px-8 py-4 text-base font-semibold transition-colors"
      >
        Solicitar Presupuesto por WhatsApp
        <ArrowRight class="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
