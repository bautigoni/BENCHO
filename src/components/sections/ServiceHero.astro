---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { SERVICES, type Service } from '../../data/services';

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<section data-top-brand class="border-b border-[#d9d9db] bg-[#ececed]">
  <div class="container-page pt-28 pb-12 sm:pt-32 sm:pb-16">
    <nav aria-label="Servicios" class="service-nav overflow-x-auto border-b border-[#cfd0d2]">
      <div class="flex min-w-max gap-7 sm:gap-9">
        {
          SERVICES.map((item) => (
            <a
              href={`/servicios/${item.slug}`}
              aria-current={item.slug === service.slug ? 'page' : undefined}
              class:list={[
                'relative py-3 text-sm font-medium transition-colors',
                item.slug === service.slug ? 'text-ink-950' : 'text-ink-500 hover:text-ink-950'
              ]}
            >
              {item.title}
              {item.slug === service.slug && (
                <span class="bg-brand-500 absolute inset-x-0 -bottom-px h-0.5" aria-hidden="true" />
              )}
            </a>
          ))
        }
      </div>
    </nav>

    <div class="mt-9 grid gap-8 md:grid-cols-[0.78fr_1.22fr] md:items-stretch lg:gap-12">
      <div class="flex flex-col justify-end py-2 md:py-7">
        <h1
          class="text-ink-950 max-w-[12ch] text-[clamp(2.8rem,6vw,5.7rem)] leading-[0.92] font-semibold tracking-[-0.06em] text-balance"
        >
          {service.title}
        </h1>
        <p class="text-ink-600 mt-5 max-w-md text-base leading-relaxed text-pretty sm:text-lg">
          {service.tagline}
        </p>
        <div class="mt-7">
          <Button
            whatsapp
            whatsappMessage={service.whatsappMessage}
            ctaLocation={`service_hero_${service.slug}`}
            size="lg"
            showArrow>Solicitar Presupuesto</Button
          >
        </div>
      </div>

      <figure
        class="relative h-[42dvh] max-h-[31rem] min-h-[20rem] overflow-hidden rounded-[1.75rem] bg-[#d7d7d9] shadow-[0_1.5rem_4rem_rgba(69,69,72,0.14)]"
      >
        <Image
          src={service.image}
          alt={service.imageAlt}
          class="size-full object-cover"
          widths={[640, 900, 1200, 1600]}
          sizes="(min-width: 768px) 58vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="pointer-events-none absolute inset-0 ring-1 ring-white/20 ring-inset" aria-hidden="true">
        </div>
      </figure>
    </div>
  </div>
</section>

<style>
  .service-nav {
    scrollbar-width: none;
  }

  .service-nav::-webkit-scrollbar {
    display: none;
  }
</style>
