---
import { Image } from 'astro:assets';
import logoMark from '../assets/images/logo-transparent.png';

interface Props {
  variant?: 'full' | 'mark';
  theme?: 'dark' | 'light';
  class?: string;
}

const { variant = 'full', theme = 'dark', class: className = '' } = Astro.props;
const wordmarkColor = theme === 'dark' ? '#919193' : '#f2f2f3';
---

<a
  href="/"
  aria-label="Grupo CGR — Página de inicio"
  class:list={['group inline-flex shrink-0 items-center gap-2.5', className]}
>
  <Image
    src={logoMark}
    alt=""
    width={40}
    height={40}
    class="size-9 shrink-0 object-contain transition-transform duration-300 group-hover:scale-110 group-hover:rotate-3"
  />
  {
    variant === 'full' && (
      <span class="flex flex-col leading-none">
        <span
          class="font-sans text-[1.05rem] font-medium tracking-[0.12em] uppercase"
          style={`color:${wordmarkColor}`}
        >
          Grupo CGR
        </span>
        <span
          class:list={[
            'mt-1 text-[0.52rem] font-normal tracking-[0.2em]',
            theme === 'dark' ? 'text-logo-gray' : 'text-white/65'
          ]}
        >
          Servicios para la construcción
        </span>
      </span>
    )
  }
</a>
