---
import GtmScripts from './analytics/GtmScripts.astro';

// GA4 loads only when a Measurement ID is provided and only in production,
// so local dev never pollutes real analytics data.
const measurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const shouldLoad = import.meta.env.PROD && Boolean(measurementId);
---

{shouldLoad && <GtmScripts measurementId={measurementId as string} />}
